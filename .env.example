# ============================================================================
# TeleRoute MTProto Core — Environment Configuration (.env.example)
# ============================================================================

# 1. Server & Network
PORT=3000
HOST=0.0.0.0
RUST_LOG=info,teleroute=debug
APP_ENV=production

# 2. Database Configuration
# Default embedded SQLite database (uses WAL mode, busy_timeout=5000ms)
DATABASE_URL=sqlite:///data/teleroute.db?mode=rwc
SQLITE_PATH=./data/teleroute.db
# Optional PostgreSQL profile for multi-replica / large deployments:
# DATABASE_URL=postgres://teleroute:changeme@postgres:5432/teleroute

# 3. Cryptographic Keys (Mandatory in production)
# 32-byte hex or base64 key used for AES-256-GCM encryption of Telegram MTProto session at rest.
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=

# Secret key for signing HttpOnly administrative session cookies
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# 4. Telegram MTProto API Credentials (Optional env prefill; can also be configured in UI)
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 5. Memory & Worker Bounds (Tuned for small 512MB - 1GB RAM Linux VPS)
MAX_QUEUE_DEPTH=2000
DELIVERY_CONCURRENCY=2
BACKFILL_BATCH_SIZE=100
GLOBAL_SEND_DELAY_MS=500
MIN_SEND_INTERVAL_MS=1000
COOKIE_SECURE=false
